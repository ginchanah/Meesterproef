<div class="container">
    <div class="animation-section active" id="anim-control">
        <canvas id="c"></canvas>
    </div>
</div>

<script>
    // @ts-nocheck
    
    const cv = document.getElementById("c");
    const ctx = cv.getContext("2d");
    const container = cv.closest(".animation-section");
    const SP = 7;
    const G = 5;
    const PI = Math.PI;

    // ---- Geometry Helper Functions ----
    const lin = (a, b, c, d) => {
        const n = Math.max(2, Math.ceil(Math.hypot(c - a, d - b) / SP));
        return Array.from({ length: n + 1 }, (_, i) => [a + (c - a) * i / n, b + (d - b) * i / n]);
    };

    const arc = (cx, cy, r, a0, a1, closed) => {
        const n = Math.max(4, Math.ceil(Math.abs(a1 - a0) * r / SP));
        const m = closed ? n : n + 1;
        return Array.from({ length: m }, (_, i) => {
        const a = a0 + (a1 - a0) * i / n;
        return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
        });
    };

    const quad = (p0, c, p1) => Array.from({ length: 11 }, (_, i) => {
        const t = i / 10;
        const u = 1 - t;
        return [
        u * u * p0[0] + 2 * u * t * c[0] + t * t * p1[0],
        u * u * p0[1] + 2 * u * t * c[1] + t * t * p1[1]
        ];
    });

    const S = [];
    const add = (pts, closed, X) => S.push({
        closed: !!closed,
        home: pts.map(p => [p[0] + X, p[1]]),
        o: pts.map(() => [0, 0]),
        v: pts.map(() => [0, 0])
    });

    // ---- Letter Shape Definitions ----
    function buildC(X) { for (let i = 0; i < 4; i++) add(arc(50, 50, 50 - i * G, PI / 4, 7 * PI / 4), 0, X); }
    function buildO(X) {
        for (let i = 0; i < 8; i++) {
        const r = 50 - i * 4.5;
        add(Array.from({ length: 36 }, (_, k) => [50 + r * Math.cos(k * PI / 18), 50 + r * Math.sin(k * PI / 18)]), true, X);
        }
    }
    function buildN(X) {
        for (let i = 0; i < 4; i++) {
        const r = 40 - i * G;
        add(lin(50 - r, 0, 50 - r, 100), 0, X);
        add(arc(50, 50, r, PI, 2 * PI).concat(lin(50 + r, 50, 50 + r, 100).slice(1)), 0, X);
        }
    }
    function buildT(X) {
        for (let i = 0; i < 3; i++) {
        add(lin(30 + i * G, -35, 30 + i * G, 100), 0, X);
        add(lin(5, 5 + i * G, 75, 5 + i * G), 0, X);
        }
    }
    function buildR(X) {
        for (let i = 0; i < 4; i++) {
        const x = 10 + i * G;
        add(lin(x, 0, x, 100), 0, X);
        add(quad([x, 50], [x, i * G], [62, i * G]), 0, X);
        }
    }
    function buildL(X) {
        for (let i = 0; i < 4; i++) add(lin(5 + i * G, -40, 5 + i * G, 100), 0, X);
    }

    const LS = [];
    [[buildC, 0], [buildO, 118], [buildN, 236], [buildT, 354], [buildR, 452], [buildO, 540], [buildL, 658]].forEach(([f, X]) => {
        LS.push(S.length);
        f(X);
    });

    let T = [];
    let all = S.slice();

    // Web connections
    const LINKS = [
        [[0, 0, 1], [1, 0, .625]], [[0, 0, 0], [1, 0, .375]], [[1, 0, .875], [2, 0, 0]], [[1, 0, .125], [2, 0, 1]],
        [[2, 1, 1], [3, 0, 1]], [[2, 1, .5], [3, 1, 0]], [[3, 1, 1], [4, 0, 0]], [[3, 0, 1], [4, 0, 1]],
        [[4, 1, 1], [5, 0, .625]], [[4, 0, 1], [5, 0, .375]], [[5, 0, .875], [6, 0, 0]], [[5, 0, .125], [6, 0, 1]],
        [[0, 0, .5], "L"], [[0, 0, .35], "BL"], [[0, 0, .65], "TL"], [[1, 0, .75], "T"], [[1, 0, .25], "B"],
        [[2, 1, .5], "T"], [[2, 0, 1], "B"], [[3, 0, 0], "T"], [[4, 0, 1], "B"], [[5, 0, .75], "T"], [[5, 0, .25], "B"],
        [[6, 0, 0], "TR"], [[6, 0, 1], "BR"], [[6, 0, .5], "R"]
    ];

    // Ties: stitching strings to neighbors
    const TIES = [];
    const tie = (A, B) => TIES.push([A, B, 1]);
    
    for (const k of [1, 5]) for (let j = 0; j < 7; j++) for (let m = 0; m < 6; m++) tie([k, j, m / 6], [k, j + 1, m / 6]);
    for (let j = 0; j < 3; j++) for (const f of [0, .25, .5, .75, 1]) tie([0, j, f], [0, j + 1, f]);
    for (let j = 0; j < 3; j++) for (const f of [0, .5, 1]) tie([6, j, f], [6, j + 1, f]);
    
    for (let i = 0; i < 4; i++) {
        if (i < 3) for (const f of [0, .5, 1]) {
        tie([2, 2 * i, f], [2, 2 * i + 2, f]);
        tie([2, 2 * i + 1, f], [2, 2 * i + 3, f]);
        tie([4, 2 * i, f], [4, 2 * i + 2, f]);
        tie([4, 2 * i + 1, f], [4, 2 * i + 3, f]);
        }
        tie([2, 2 * i, .5], [2, 2 * i + 1, 0]);
        tie([4, 2 * i, .5], [4, 2 * i + 1, 0]);
    }
    for (let i = 0; i < 3; i++) {
        if (i < 2) for (const f of [0, .5, 1]) {
        tie([3, 2 * i, f], [3, 2 * i + 2, f]);
        tie([3, 2 * i + 1, f], [3, 2 * i + 3, f]);
        }
        tie([3, 2 * i, (40 + i * 5) / 135], [3, 2 * i + 1, (25 + i * 5) / 70]);
    }

    const ATT = (k, j, f) => {
        const s = S[LS[k] + j];
        const n = s.home.length;
        return { s, i: Math.min(n - 1, Math.round(f * (s.closed ? n : n - 1))) % n };
    };

    const cur = a => [a.s.home[a.i][0] + a.s.o[a.i][0], a.s.home[a.i][1] + a.s.o[a.i][1]];
    const edgePt = (e, h) => [e.includes("L") ? EL : e.includes("R") ? ER : h[0], e.includes("T") ? ET : e.includes("B") ? EB : h[1]];

    function buildTethers() {
        T = LINKS.concat(TIES).map(([A, B, w]) => {
        const a = ATT(...A);
        const b = typeof B === "string" ? { edge: B } : ATT(...B);
        const p = a.s.home[a.i];
        const q = b.edge ? edgePt(b.edge, p) : b.s.home[b.i];
        const n = Math.max(6, Math.ceil(Math.hypot(q[0] - p[0], q[1] - p[1]) / 9));
        const z = () => Array.from({ length: n }, () => [0, 0]);
        return { a, b, kt: w ? .03 : .006, tie: !!w, closed: false, home: z(), o: z(), v: z() };
        });
        all = S.concat(T);
        grab = null;
    }

    const W_U = 683, TOP = -40, BOT = 100;

    // ---- Layout State ----
    let sc = 1, ox = 0, oy = 0, ink = "#ece9e1", bg = "#121212";
    let hot = null, grab = null, mx = 0, my = 0;
    let EL = 0, ER = 0, ET = 0, EB = 0;
    let RW = 0, RH = 0;
    let idleTime = 0; // Toegevoegd voor de idle animatie

    function resize() {
        const d = devicePixelRatio || 1;
        const w = container.clientWidth || cv.clientWidth;
        const h = container.clientHeight || cv.clientHeight;
        if (!w || !h) return;
        
        RW = w;
        RH = h;
        cv.width = w * d;
        cv.height = h * d;
        ctx.setTransform(d, 0, 0, d, 0, 0);
        
        sc = Math.min(w * .92 / W_U, h * .72 / (BOT - TOP));
        ox = (w - W_U * sc) / 2;
        oy = h / 2 - (TOP + BOT) / 2 * sc;
        
        // Read the CSS variables directly
        const rootStyles = getComputedStyle(document.documentElement);
        ink = rootStyles.getPropertyValue('--text').trim() || rootStyles.getPropertyValue('--color-text').trim() || "#ece9e1";
        bg = rootStyles.getPropertyValue('--bg').trim() || rootStyles.getPropertyValue('--color-background').trim() || "#121212";
        
        EL = -ox / sc;
        ER = (w - ox) / sc;
        ET = -oy / sc;
        EB = (h - oy) / sc;
        
        buildTethers();
    }

    addEventListener("resize", resize);
    resize();

    // ---- Interaction Handling ----
    const pos = e => {
        const r = cv.getBoundingClientRect();
        return [e.clientX - r.left, e.clientY - r.top];
    };

    function nearest(px, py, rad) {
        let best = null, bd = rad * rad;
        for (const s of all) {
        for (let i = 0; i < s.home.length; i++) {
            const x = ox + (s.home[i][0] + s.o[i][0]) * sc - px;
            const y = oy + (s.home[i][1] + s.o[i][1]) * sc - py;
            const d = x * x + y * y;
            if (d < bd) {
            bd = d;
            best = { s, i };
            }
        }
        }
        return best;
    }

    cv.addEventListener("pointerdown", e => {
        [mx, my] = pos(e);
        grab = nearest(mx, my, 30);
        if (grab) {
        hot = grab.s;
        cv.setPointerCapture(e.pointerId);
        cv.style.cursor = "grabbing";
        }
    });

    cv.addEventListener("pointermove", e => {
        [mx, my] = pos(e);
        if (!grab) {
        const q = nearest(mx, my, 30);
        hot = q && q.s;
        cv.style.cursor = q ? "grab" : "default";
        }
    });

    const release = () => {
        grab = null;
        hot = null;
        cv.style.cursor = "default";
    };
    cv.addEventListener("pointerup", release);
    cv.addEventListener("pointercancel", release);

    // ---- Physics: Spring-to-Home + Neighbor Coupling ----
    const K = .012, C = .45, D = .03;
    function step() {
        idleTime += 0.02; // Update de animatietijd per frame

        for (const t of T) {
        const p = cur(t.a);
        const q = t.b.edge ? edgePt(t.b.edge, t.a.s.home[t.a.i]) : cur(t.b);
        const n = t.home.length;
        for (let j = 0; j < n; j++) {
            const u = j / (n - 1);
            t.home[j][0] = p[0] + (q[0] - p[0]) * u;
            t.home[j][1] = p[1] + (q[1] - p[1]) * u;
        }
        }
        
        for (const s of all) {
        const n = s.o.length, o = s.o, v = s.v;
        for (let i = 0; i < n; i++) {
            const a = s.closed ? o[(i + n - 1) % n] : o[Math.max(i - 1, 0)];
            const b = s.closed ? o[(i + 1) % n] : o[Math.min(i + 1, n - 1)];

            // Veilige golfbeweging door het rustpunt (target) subtiel te verschuiven
            const targetX = Math.sin(idleTime + s.home[i][1] * 0.05) * 4;
            const targetY = Math.cos(idleTime * 0.8 + s.home[i][0] * 0.05) * 4;

            v[i][0] += -K * (o[i][0] - targetX) + C * (a[0] + b[0] - 2 * o[i][0]) - D * v[i][0];
            v[i][1] += -K * (o[i][1] - targetY) + C * (a[1] + b[1] - 2 * o[i][1]) - D * v[i][1];
        }
        for (let i = 0; i < n; i++) {
            o[i][0] += v[i][0];
            o[i][1] += v[i][1];
        }
        }
        
        for (const t of T) {
        const n = t.o.length;
        if (t.a.s && t.b.s) {
            for (let k = 0; k < 2; k++) {
            const d = t.b.s.o[t.b.i][k] - t.a.s.o[t.a.i][k];
            t.a.s.v[t.a.i][k] += t.kt * d;
            t.b.s.v[t.b.i][k] -= t.kt * d;
            }
        }
        for (const e of [[t.a, 1], [t.b, n - 2]]) {
            if (e[0].s) {
            for (let k = 0; k < 2; k++) e[0].s.v[e[0].i][k] += .12 * t.o[e[1]][k];
            }
        }
        t.o[0][0] = t.o[0][1] = t.o[n - 1][0] = t.o[n - 1][1] = 0;
        t.v[0][0] = t.v[0][1] = t.v[n - 1][0] = t.v[n - 1][1] = 0;
        }
        
        if (grab) {
        const { s, i } = grab;
        s.o[i][0] = (mx - ox) / sc - s.home[i][0];
        s.o[i][1] = (my - oy) / sc - s.home[i][1];
        s.v[i][0] = s.v[i][1] = 0;
        }
    }

    // ---- Rendering ----
    function draw() {
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, RW, RH);
        
        ctx.strokeStyle = ink;
        const base = Math.max(.9, sc * .4);
        ctx.lineJoin = ctx.lineCap = "round";
        
        for (const s of all) {
        let w = base, al = 1;
        if (s.a) {
            if (s.tie) { w = base * .55; al = .6; }
            else { w = base * .7; al = .8; }
        }
        if (s === hot) { w = base * 2; al = 1; }
        
        ctx.lineWidth = w;
        ctx.globalAlpha = al;
        
        const n = s.home.length;
        const P = i => [ox + (s.home[i][0] + s.o[i][0]) * sc, oy + (s.home[i][1] + s.o[i][1]) * sc];
        
        ctx.beginPath();
        if (s.closed) {
            let a = P(n - 1), b = P(0);
            ctx.moveTo((a[0] + b[0]) / 2, (a[1] + b[1]) / 2);
            for (let i = 0; i < n; i++) {
            const p = P(i), q = P((i + 1) % n);
            ctx.quadraticCurveTo(p[0], p[1], (p[0] + q[0]) / 2, (p[1] + q[1]) / 2);
            }
            ctx.closePath();
        } else {
            let p = P(0);
            ctx.moveTo(p[0], p[1]);
            for (let i = 1; i < n - 1; i++) {
            const a = P(i), b = P(i + 1);
            ctx.quadraticCurveTo(a[0], a[1], (a[0] + b[0]) / 2, (a[1] + b[1]) / 2);
            }
            p = P(n - 1);
            ctx.lineTo(p[0], p[1]);
        }
        ctx.stroke();
        }
        
        // Knots where the web is tied to a letter
        ctx.globalAlpha = 1;
        ctx.lineWidth = base * .9;
        ctx.fillStyle = bg;
        for (const t of T) {
        if (!t.tie) {
            for (const e of [t.a, t.b]) {
            if (e.s) {
                const p = cur(e);
                ctx.beginPath();
                ctx.arc(ox + p[0] * sc, oy + p[1] * sc, Math.max(2, sc * .8), 0, 6.2832);
                ctx.fill();
                ctx.stroke();
            }
            }
        }
        }
    }

    function frame() {
        if ((container.clientWidth && container.clientWidth !== RW) || (container.clientHeight && container.clientHeight !== RH) || !RW) resize();
        if (!RW) {
        requestAnimationFrame(frame);
        return;
        }
        step();
        step();
        draw();
        requestAnimationFrame(frame);
    }
    
    frame();
</script>