<script>
// =====================================
// MARK: Script liminal-space
// =====================================
// @ts-nocheck

const root = document.documentElement;

let mouseFollower = (e) => {
    let middleScreenX = window.innerWidth / 2
    let middleScreenY = window.innerHeight / 2
    let x = e.clientX
    let y = e.clientY
    let offsetX = e.clientX - middleScreenX;
    let offsetY = middleScreenY - e.clientY;

    const percentX = (offsetX / middleScreenX)
    const percentY = (offsetY / middleScreenY)
    // Bron: https://www.tutorialspoint.com/article/how-to-write-a-javascript-function-to-get-the-difference-between-two-numbers
    root.style.setProperty("--mouse-x", percentX);
    root.style.setProperty("--mouse-y", percentY);
}

document.addEventListener("mousemove", (e) => {
    mouseFollower(e)
})
</script>