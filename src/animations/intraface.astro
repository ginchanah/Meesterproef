---

<div class="scene"><div class="cube"></div></div>

<script>
    // @ts-nocheck

    // ---------- CSS Variabelen Uitlezen ----------
    const rootStyles = getComputedStyle(document.documentElement);
    const getVar = (name) => rootStyles.getPropertyValue(name).trim();

    const THEMES = {
        dark: {
            face: getVar("--face-bg-dark"),
            text: getVar("--text-color-dark"),
            g1bg: getVar("--g1-bg-dark"),
            g1: getVar("--g1-color-dark"),
            g2bg: getVar("--g2-bg-dark"),
            g2: getVar("--g2-color-dark"),
        },
        light: {
            face: getVar("--face-bg-light"),
            text: getVar("--text-color-light"),
            g1bg: getVar("--g1-bg-light"),
            g1: getVar("--g1-color-light"),
            g2bg: getVar("--g2-bg-light"),
            g2: getVar("--g2-color-light"),
        },
    };

    let theme = THEMES.dark;

    // ---------- Instellingen ----------
    const W = 300,
        H = 300,
        LH = 15,
        ROWS = 20;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    const FONT = "bold 15px 'Courier New', Courier, monospace";
    const TEXT_MS = 150; // hoe vaak de tekst verandert
    const FRAME_MS = 32; // ~30 fps voor de glitch-banden

    // ---------- Tekstgenerator ----------
    const symbolsFull = "@%#*+=-::",
        symbolsHeavy = "@%#*",
        symbolsLight = "+=-::";
    const numbersFull = "0123456789",
        numbersBinary = "01";

    function rnd(chars, n) {
        let s = "";
        for (let i = 0; i < n; i++)
            s += chars[(Math.random() * chars.length) | 0];
        return s;
    }

    function fragment(type) {
        if (Math.random() < 0.15) return "        ";
        const len = ((Math.random() * 6) | 0) + 3;
        switch (type) {
            case "front":
                return rnd(symbolsFull, len);
            case "back":
                return rnd(numbersBinary, len + 4);
            case "left":
                return rnd(numbersFull, len);
            case "right":
                return rnd(symbolsFull + numbersFull, len);
            case "top":
                return rnd(symbolsHeavy, len);
            case "bottom":
                return rnd(symbolsLight, len);
            default:
                return rnd(symbolsFull, len);
        }
    }

    function typingGlitch(words) {
        return words
            .map((w) => {
                if (w === "        ") return w;
                if (w.length > 3 && Math.random() < 0.4) {
                    const keep = ((Math.random() * (w.length - 1)) | 0) + 1;
                    return (
                        w.substring(0, keep) + (Math.random() > 0.5 ? "_" : "")
                    );
                }
                return w;
            })
            .join("  ");
    }

    // ---------- Canvas helpers ----------
    function makeCanvas() {
        const c = document.createElement("canvas");
        c.width = W * DPR;
        c.height = H * DPR;
        const x = c.getContext("2d");
        x.setTransform(DPR, 0, 0, DPR, 0, 0);
        x.font = FONT;
        x.textBaseline = "middle";
        if ("letterSpacing" in x) x.letterSpacing = "-1px";
        return { c, x };
    }

    const probe = makeCanvas();
    const ADV = probe.x.measureText("MMMMMMMMMM").width / 10;
    const COLS = Math.ceil(W / ADV) + 1;
    const MAXCHARS = COLS * ROWS;

    function paint(layer, str, bg, fg) {
        const x = layer.x;
        x.fillStyle = bg;
        x.fillRect(0, 0, W, H);
        x.fillStyle = fg;
        for (let r = 0; r < ROWS; r++) {
            const row = str.substr(r * COLS, COLS);
            if (!row) break;
            x.fillText(row, 0, r * LH + LH / 2);
        }
    }

    const INTRA = Array(80).fill("intraface").join("  ");

    // ---------- Vlakken opbouwen ----------
    const cube = document.querySelector(".cube");
    const faces = ["front", "back", "left", "right", "top", "bottom"].map(
        (type) => {
            const el = document.createElement("div");
            el.className = "face " + type;
            const view = makeCanvas();
            el.appendChild(view.c);
            cube.appendChild(el);

            const words = [];
            for (let i = 0; i < 100; i++) words.push(fragment(type));
            return {
                type,
                words,
                view,
                base: makeCanvas(),
                g1: makeCanvas(),
                g2: makeCanvas(),
                s0: "",
                s1: "",
            };
        },
    );

    function repaintFace(f) {
        paint(f.base, f.s0, theme.face, theme.text);
        paint(f.g1, f.s1, theme.g1bg, theme.g1);
        paint(f.g2, INTRA, theme.g2bg, theme.g2);
    }

    function stepText() {
        for (const f of faces) {
            f.words.shift();
            f.words.push(fragment(f.type));
            f.s0 = f.words.join("  ").substr(0, MAXCHARS);
            f.s1 = typingGlitch(f.words).substr(0, MAXCHARS);
            repaintFace(f);
        }
    }

    // ---------- Glitch-banden ----------
    const G1 = {
        t: [10, 80, 30, 50, 5, 90],
        b: [80, 10, 50, 30, 90, 5],
        x: [-4, 4, -4, 4, -4, 4],
        d: 2000,
    };
    const G2 = {
        t: [15, 60, 25, 85, 40],
        b: [70, 20, 55, 10, 40],
        x: [3, -3, 3, -3, 3],
        d: 3000,
    };

    function kf(arr, u) {
        const n = arr.length - 1,
            p = u * n,
            i = Math.min(Math.floor(p), n - 1);
        return arr[i] + (arr[i + 1] - arr[i]) * (p - i);
    }

    function prog(now, d) {
        const p = (now % (d * 2)) / d;
        return p < 1 ? 1 - p : p - 1;
    }

    function band(f, layer, g, now) {
        const u = prog(now, g.d);
        const top = (kf(g.t, u) / 100) * H;
        const h = H - (kf(g.b, u) / 100) * H - top;
        if (h <= 0) return;
        f.view.x.drawImage(
            layer.c,
            0,
            top * DPR,
            W * DPR,
            h * DPR,
            kf(g.x, u),
            top,
            W,
            h,
        );
    }

    function composite(now) {
        for (const f of faces) {
            f.view.x.drawImage(f.base.c, 0, 0, W, H);
            band(f, f.g1, G1, now);
            band(f, f.g2, G2, now);
        }
    }

    // ---------- Hoofdloop ----------
    let lastDraw = 0,
        lastText = -TEXT_MS;
    function frame(now) {
        requestAnimationFrame(frame);
        if (now - lastDraw < FRAME_MS) return;
        lastDraw = now;
        if (now - lastText >= TEXT_MS) {
            lastText = now;
            stepText();
        }
        composite(now);
    }
    stepText();
    requestAnimationFrame(frame);

    // ---------- Thema wissel ----------
    let themeInterval;
    function toggleTheme() {
        const inv = document.body.classList.toggle("inverted");
        theme = inv ? THEMES.light : THEMES.dark;
        faces.forEach(repaintFace);
    }
    function startThemeInterval() {
        themeInterval = setInterval(toggleTheme, 4000);
    }
    startThemeInterval();
    document.addEventListener("click", () => {
        toggleTheme();
        clearInterval(themeInterval);
        startThemeInterval();
    });
</script>
