<div class="animation-container">
    <canvas id="c"></canvas>
</div>

<script>
    // @ts-nocheck

    // ==========================================
    // 3. CSS KLEUREN INLADEN IN JAVASCRIPT
    // ==========================================
    // Haal de berekende stijlen van het hoofddocument (HTML) op
    const rootStyles = getComputedStyle(document.documentElement);

    // Lees de specifieke CSS-variabelen uit en verwijder eventuele extra spaties (.trim())
    const colorText = rootStyles.getPropertyValue("--text-color").trim();
    const colorEdges = rootStyles.getPropertyValue("--edges-color").trim();
    const colorNodes = rootStyles.getPropertyValue("--nodes-color").trim();

    // ==========================================
    // 4. BASIS INSTELLINGEN & VARIABELEN
    // ==========================================
    const C = document.getElementById("c");
    const ctx = C.getContext("2d"); // De 2D tekencontext
    const container = C.closest(".animation-container"); // De container waarin het canvas zit

    const N = 420; // Totaal aantal bolletjes (nodes)

    // Het woord bepaalt de groepen (clusters). 7 letters = 7 clusters bolletjes.
    const word = "ECOLOGY";
    const CLUSTERS = word.length;

    // Globale variabelen voor schermgrootte, middenpunt (cx, cy), radius, zoom en camera-positie (pan)
    let W,
        H,
        cx,
        cy,
        R,
        zoom = 1,
        panX = 0,
        panY = 0,
        drag = null,
        pan = null;

    // ==========================================
    // 5. HULPFUNCTIES
    // ==========================================

    // Zorgt ervoor dat het canvas altijd de container vult, ook bij het aanpassen van het venster
    function resize() {
        const d = devicePixelRatio || 1; // Houdt rekening met retina/hoge resolutie schermen
        W = container.clientWidth;
        H = container.clientHeight;
        C.width = W * d;
        C.height = H * d;
        C.style.width = W + "px";
        C.style.height = H + "px";
        ctx.setTransform(d, 0, 0, d, 0, 0); // Schaal de context mee
        cx = W / 2; // X-midden
        cy = H / 2; // Y-midden
        R = Math.min(W, H) * 0.38; // Radius waarop de letters ongeveer verdeeld worden
    }
    resize();
    window.addEventListener("resize", resize); // Pas aan als het venster van grootte verandert

    // Genereert een 'Normale Verdeling' (Gaussiaans), zorgt dat bolletjes zich vaker in het midden van een letter concentreren
    function gauss() {
        let u = 0,
            v = 0;
        while (!u) u = Math.random();
        while (!v) v = Math.random();
        return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    // ==========================================
    // 6. DATA GENERATIE (CLUSTERS, NODES, EDGES)
    // ==========================================

    // Bepaal de doellocaties (clusters) voor elke letter in een cirkelpatroon
    const clusters = Array.from({ length: CLUSTERS }, (_, i) => {
        const a = (i / CLUSTERS) * Math.PI * 2; // Hoek in de cirkel
        const d = R * (0.3 + Math.random() * 0.7); // Afstand vanuit het centrum
        return {
            x: cx + Math.cos(a) * d,
            y: cy + Math.sin(a) * d,
            s: 30 + Math.random() * 60, // Spreidingsgrootte van de letter
            char: word[i], // Sla de specifieke letter op ("E", "C", "O", etc.)
        };
    });

    // Maak de bolletjes (nodes) aan en wijs ze toe aan een willekeurig cluster (letter)
    const nodes = Array.from({ length: N }, () => {
        const c = clusters[(Math.random() * CLUSTERS) | 0]; // Kies willekeurig cluster
        const a = Math.random() * Math.PI * 2;
        const r = Math.abs(gauss()) * c.s; // Gebruik Gauss voor concentratie in het midden
        return {
            x: c.x + Math.cos(a) * r,
            y: c.y + Math.sin(a) * r,
            vx: 0, // Snelheid X
            vy: 0, // Snelheid Y
            r: 2.2 + Math.random() * 1.8, // Radius (visuele grootte) van het bolletje
            ci: clusters.indexOf(c), // Cluster index waartoe deze node behoort
        };
    });

    // Verbind de nodes met lijnen (edges)
    const edges = [];
    const edgeSet = new Set(); // Voorkomt dubbele lijnen

    function addEdge(a, b) {
        const k = a < b ? a + "-" + b : b + "-" + a; // Unieke sleutel
        if (a === b || edgeSet.has(k)) return; // Stop als lijn al bestaat of node met zichzelf verbindt
        edgeSet.add(k);
        edges.push([a, b]);
    }

    // Verbind nodes gebaseerd op afstand. Grote kans binnen dezelfde letter, kleine kans tussen verschillende letters.
    for (let i = 0; i < N; i++) {
        for (let j = i + 1; j < N; j++) {
            const dx = nodes[i].x - nodes[j].x;
            const dy = nodes[i].y - nodes[j].y;
            const d = Math.sqrt(dx * dx + dy * dy);

            // P is de kans op een verbinding
            const p =
                nodes[i].ci === nodes[j].ci
                    ? Math.max(0, 0.35 - d / 300)
                    : Math.max(0, 0.012 - d / 8000);
            if (Math.random() < p) addEdge(i, j);
        }
    }

    // Zorg dat geen enkel bolletje volledig losraakt (isoleerde nodes verbinden met hun dichtstbijzijnde buur)
    for (let i = 0; i < N; i++) {
        if (!edges.some(([a, b]) => a === i || b === i)) {
            let best = 0,
                bestD = Infinity;
            for (let j = 0; j < N; j++) {
                if (j !== i) {
                    const d =
                        (nodes[i].x - nodes[j].x) ** 2 +
                        (nodes[i].y - nodes[j].y) ** 2;
                    if (d < bestD) {
                        bestD = d;
                        best = j;
                    }
                }
            }
            addEdge(i, best);
        }
    }

    // Creëer 'Hubs': Koppel enkele willekeurige nodes aan heel veel andere nodes voor een web-effect
    for (let h = 0; h < 8; h++) {
        const hub = (Math.random() * N) | 0;
        for (let i = 0; i < 8 + Math.random() * 12; i++) {
            addEdge(hub, (Math.random() * N) | 0);
        }
    }

    // ==========================================
    // 7. INPUT HANDLERS (MUIS / TOUCH)
    // ==========================================

    // Vertaal muiscoördinaten naar "wereld"-coördinaten (houdt rekening met zoom en pan)
    function s2w(sx, sy) {
        const rect = C.getBoundingClientRect();
        const localX = sx - rect.left;
        const localY = sy - rect.top;
        return {
            x: (localX - W / 2) / zoom + cx - panX,
            y: (localY - H / 2) / zoom + cy - panY,
        };
    }

    // Zoek het bolletje dat het dichtst bij de muisklik in de buurt is
    function findNode(sx, sy) {
        const { x, y } = s2w(sx, sy);
        let best = -1,
            bd = 18 / zoom; // Detectie-radius past zich aan zoom aan
        for (let i = 0; i < N; i++) {
            const d = Math.hypot(nodes[i].x - x, nodes[i].y - y);
            if (d < bd) {
                bd = d;
                best = i;
            }
        }
        return best;
    }

    // Muis/Touch acties
    C.onmousedown = (e) => {
        const i = findNode(e.clientX, e.clientY);
        i >= 0 ? (drag = i) : (pan = { x: e.clientX, y: e.clientY }); // Sleep node, OF beweeg hele canvas
    };

    C.onmousemove = (e) => {
        if (drag !== null) {
            // Verplaats een vastgepakte node
            const p = s2w(e.clientX, e.clientY);
            nodes[drag].x = p.x;
            nodes[drag].y = p.y;
            nodes[drag].vx = nodes[drag].vy = 0;
        } else if (pan) {
            // Pannen (schuiven) door het hele veld
            panX += (e.clientX - pan.x) / zoom;
            panY += (e.clientY - pan.y) / zoom;
            pan.x = e.clientX;
            pan.y = e.clientY;
        }
    };

    C.onmouseup = C.onmouseleave = () => {
        drag = null;
        pan = null;
    }; // Laat los

    // ==========================================
    // 8. NATUURKUNDE EN WEERGAVE LUS (ANIMATION LOOP)
    // ==========================================
    requestAnimationFrame(function loop() {
        // Bereken de randen van het scherm in "wereld"-coördinaten
        const minX = -W / 2 / zoom + cx - panX;
        const maxX = W / 2 / zoom + cx - panX;
        const minY = -H / 2 / zoom + cy - panY;
        const maxY = H / 2 / zoom + cy - panY;

        // Hierin slaan we de gemiddelde positie op van de bolletjes in één letter
        const clusterCenters = Array.from({ length: CLUSTERS }, () => ({
            x: 0,
            y: 0,
            count: 0,
        }));

        // 8A. Lijn-natuurkunde (Veringen)
        // Trekt verbonden nodes naar elkaar toe
        for (const [a, b] of edges) {
            const dx = nodes[b].x - nodes[a].x;
            const dy = nodes[b].y - nodes[a].y;
            const d = Math.sqrt(dx * dx + dy * dy) || 1;
            const f = (d - 50) * 0.0004; // Veer-constante
            const fx = (dx / d) * f;
            const fy = (dy / d) * f;
            if (a !== drag) {
                nodes[a].vx += fx;
                nodes[a].vy += fy;
            }
            if (b !== drag) {
                nodes[b].vx -= fx;
                nodes[b].vy -= fy;
            }
        }

        // 8B. Node-natuurkunde
        for (let i = 0; i < N; i++) {
            if (i === drag) continue; // Genegeerde node als de gebruiker deze vasthoudt

            // Lichte aantrekkingskracht naar het absolute midden van het scherm
            nodes[i].vx += (cx - nodes[i].x) * 0.00008;
            nodes[i].vy += (cy - nodes[i].y) * 0.00008;

            // Bolletjes duwen elkaar lichtjes weg als ze te dichtbij komen
            for (let k = 0; k < 5; k++) {
                const j = (Math.random() * N) | 0; // Check een paar willekeurige nodes per frame (optimalisatie)
                if (j === i) continue;
                const dx = nodes[i].x - nodes[j].x,
                    dy = nodes[i].y - nodes[j].y,
                    d2 = dx * dx + dy * dy;
                if (d2 < 2500 && d2 > 0.1) {
                    const f = 80 / d2;
                    nodes[i].vx += dx * f;
                    nodes[i].vy += dy * f;
                }
            }

            // Wrijving (voorkomt dat de nodes oneindig blijven versnellen)
            nodes[i].vx *= 0.92;
            nodes[i].vy *= 0.92;

            // Pas snelheid toe op positie
            nodes[i].x += nodes[i].vx;
            nodes[i].y += nodes[i].vy;

            // Stuiteren tegen de randen van het venster
            if (nodes[i].x < minX + nodes[i].r) {
                nodes[i].x = minX + nodes[i].r;
                nodes[i].vx *= -1;
            } else if (nodes[i].x > maxX - nodes[i].r) {
                nodes[i].x = maxX - nodes[i].r;
                nodes[i].vx *= -1;
            }
            if (nodes[i].y < minY + nodes[i].r) {
                nodes[i].y = minY + nodes[i].r;
                nodes[i].vy *= -1;
            } else if (nodes[i].y > maxY - nodes[i].r) {
                nodes[i].y = maxY - nodes[i].r;
                nodes[i].vy *= -1;
            }

            // Tel de posities bij elkaar op om het zwaartepunt van een letter uit te rekenen
            clusterCenters[nodes[i].ci].x += nodes[i].x;
            clusterCenters[nodes[i].ci].y += nodes[i].y;
            clusterCenters[nodes[i].ci].count++;
        }

        // ==========================================
        // 9. TEKENEN OP HET CANVAS
        // ==========================================
        ctx.clearRect(0, 0, W, H); // Wis vorige frame

        ctx.save();
        // Verplaats origin naar midden, pas zoom en pan toe
        ctx.translate(W / 2, H / 2);
        ctx.scale(zoom, zoom);
        ctx.translate(-cx + panX, -cy + panY);

        // --- 9A. TEKEN DE LETTERS ACHTER DE ZWERM ---
        ctx.font = 'bold 160px "Inter", sans-serif';
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";

        ctx.strokeStyle = colorText; // Kleur uit CSS variabelen
        ctx.lineWidth = 1;

        for (let i = 0; i < CLUSTERS; i++) {
            if (clusterCenters[i].count > 0) {
                // Berekent de perfecte X en Y van de letter, gebaseerd op waar zijn nodes uithangen
                const px = clusterCenters[i].x / clusterCenters[i].count;
                const py = clusterCenters[i].y / clusterCenters[i].count;
                ctx.strokeText(clusters[i].char, px, py);
            }
        }

        // --- 9B. TEKEN DE VERBINDINGSLIJNEN ---
        ctx.beginPath();
        ctx.strokeStyle = colorEdges; // Kleur uit CSS variabelen
        ctx.lineWidth = 0.5;
        for (const [a, b] of edges) {
            ctx.moveTo(nodes[a].x, nodes[a].y);
            ctx.lineTo(nodes[b].x, nodes[b].y);
        }
        ctx.stroke();

        // --- 9C. TEKEN DE BOLLETJES (NODES) ---
        ctx.fillStyle = colorNodes; // Kleur uit CSS variabelen
        for (const n of nodes) {
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fill();
        }

        ctx.restore(); // Herstel canvas status voor volgende iteratie

        // Roep de loop opnieuw aan voor de volgende frame
        requestAnimationFrame(loop);
    });
</script>
